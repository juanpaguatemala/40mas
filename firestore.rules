rules_version = '2';

// Reglas de Firestore para «24 más».
// La app no lee ni escribe Firestore desde el navegador: todo pasa por el servidor
// (Firebase Admin), que verifica la sesión, el acceso y el día desbloqueado.
// Por eso se bloquea todo acceso directo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
